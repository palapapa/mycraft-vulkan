If:
  PathExclude: build/.*
CompileFlags:
  Add: 
    - -Weverything
    - -Wno-c++98-compat
    - -Wno-c++98-compat-pedantic
    - -Wno-pre-c23-compat
    - -Wno-reserved-macro-identifier
    - -Wno-padded
    - -Wno-unsafe-buffer-usage
    - -Wno-empty-translation-unit
    - -Wno-switch-default
    - -Wno-weak-vtables
    - -Wno-exit-time-destructors
    - -Wno-global-constructors
    - -Wno-unused-macros
    - -Wno-shadow-field-in-constructor
    - -ferror-limit=0
Diagnostics:
  ClangTidy:
    Add: "*"
    Remove: [
      altera-*,
      android-cloexec-*,
      llvmlibc-*,
      fuchsia-*,
      readability-identifier-length,
      readability-function-cognitive-complexity,
      cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
      concurrency-mt-unsafe,
      llvm-prefer-static-over-anonymous-namespace,
      cppcoreguidelines-avoid-c-arrays, # Already checked by modernize-avoid-c-arrays
      hicpp-avoid-c-arrays, # Already checked by modernize-avoid-c-arrays
      bugprone-throwing-static-initialization,
      cert-err58-cpp
    ]
    CheckOptions: 
      modernize-use-default-member-init.UseAssignment: true
      readability-implicit-bool-conversion.AllowPointerConditions: true
      modernize-use-trailing-return-type.TransformLambdas: none
      readability-redundant-inline-specifier.StrictMode: true
      bugprone-exception-escape.CheckMain: false
    FastCheckFilter: None
  Includes:
    AnalyzeAngledIncludes: true
    IgnoreHeader:
      - flecs(/.*|[.]h) # flecs triggers false positives
  MissingIncludes: Strict
Completion:
  MacroFilter: FuzzyMatch
InlayHints:
  BlockEnd: true
  DefaultArguments: true
  TypeNameLimit: 0
Hover:
  ShowAKA: true
  MacroContentsLimit: 0
Documentation:
  CommentFormat: Doxygen
---
If:
  PathMatch: build/.*
CompileFlags:
  Remove: -W*
